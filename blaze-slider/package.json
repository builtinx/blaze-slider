{
  "type": "module",
  "name": "@builtinx/blaze-slider",
  "version": "1.0.2",
  "description": "Blazing Fast Slider For High Performance Web",
  "main": "dist/blaze-slider.cjs.js",
  "module": "dist/blaze-slider.esm.js",
  "exports": {
    ".": {
      "browser": {
        "development": {
          "import": "./dist/blaze-slider.esm.js",
          "require": "./dist/blaze-slider.cjs.dev.js"
        },
        "import": "./dist/blaze-slider.esm.js",
        "require": "./dist/blaze-slider.cjs.prod.js"
      },
      "node": {
        "development": {
          "import": "./dist/blaze-slider.esm.js",
          "require": "./dist/blaze-slider.cjs.dev.js"
        },
        "import": "./dist/blaze-slider.esm.js",
        "require": "./dist/blaze-slider.cjs.prod.js"
      },
      "development": {
        "import": "./dist/blaze-slider.esm.js",
        "require": "./dist/blaze-slider.cjs.dev.js"
      },
      "types": "./dist/blaze-slider.esm.d.ts",
      "import": "./dist/blaze-slider.esm.js",
      "require": "./dist/blaze-slider.cjs.prod.js"
    },
    "./dist/*": {
      "import": "./dist/*",
      "require": "./dist/*"
    }
  },
  "types": "dist/blaze-slider.esm.d.ts",
  "scripts": {
    "test": "jest",
    "build:css": "csso src/blaze.css --output dist/blaze.css",
    "build": "rimraf dist && rollup -c && npm run build:css && rimraf dist/types",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "blaze-slider",
    "slider",
    "swiper",
    "carousel",
    "gallery"
  ],
  "author": "Manan Tank",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "csso-cli": "^4.0.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.40.1",
    "rollup-plugin-dts": "^6.2.1",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.3"
  }
}
